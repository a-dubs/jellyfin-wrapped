# Frontend Environment Variables
# Copy this file to .env and fill in your values

# Optional: Jellyfin server URL (can also be entered in UI)
# If not set, users can enter the server URL in the application UI
VITE_JELLYFIN_SERVER_URL=http://your-jellyfin-server:8096

# Optional: Backend API URL (default: http://localhost:3000)
# Only needed if backend runs on a different port
# VITE_BACKEND_URL=http://localhost:3000

# Note: VITE_JELLYFIN_API_KEY is NO LONGER NEEDED!
# The API key is handled by the backend only (see backend/.env.example)
# The VITE_ prefix is required for Vite to expose these variables to the client
